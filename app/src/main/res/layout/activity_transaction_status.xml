<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="onClickListener"
            type="android.view.View.OnClickListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/img_screen_bg"
        tools:context=".billpay.transactions.TransactionStatusActivity">

        <!-- Toolbar -->
        <include
            android:id="@+id/lytToolbar"
            layout="@layout/lyt_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:onClickListener="@{onClickListener}" />

        <!-- Title row: "Transaction Status" + BharatConnect logo -->
        <LinearLayout
            android:id="@+id/llTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin_horizontal"
            android:layout_marginEnd="@dimen/page_margin_horizontal"
            android:layout_marginTop="@dimen/margin_medium"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytToolbar">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/proza_libre_bold"
                android:includeFontPadding="false"
                android:text="@string/titleTransactionStatus"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_20" />

        </LinearLayout>

        <!-- Status filter tabs: All / Success / Failed / Pending -->
        <LinearLayout
            android:id="@+id/llStatusTabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin_horizontal"
            android:layout_marginEnd="@dimen/page_margin_horizontal"
            android:layout_marginTop="@dimen/margin_medium"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llTitle">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvStatusAll"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_status_height"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="7dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/filter_status_bg"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStatusAll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/proza_libre_regular"
                    android:includeFontPadding="false"
                    android:text="@string/filterStatusAll"
                    android:textSize="@dimen/text_size_12" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvStatusSuccess"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_status_height"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardCornerRadius="7dp"
                app:cardBackgroundColor="@color/filter_status_bg"
                app:strokeColor="?attr/colorPrimary"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStatusSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/proza_libre_regular"
                    android:includeFontPadding="false"
                    android:text="@string/filterStatusSuccess"
                    android:textSize="@dimen/text_size_12" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvStatusFailed"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_status_height"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardCornerRadius="7dp"
                app:cardBackgroundColor="@color/filter_status_bg"
                app:strokeColor="?attr/colorPrimary"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStatusFailed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/proza_libre_regular"
                    android:includeFontPadding="false"
                    android:text="@string/filterStatusFailed"
                    android:textSize="@dimen/text_size_12" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvStatusPending"
                android:layout_width="0dp"
                android:layout_height="@dimen/filter_status_height"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardCornerRadius="7dp"
                app:cardBackgroundColor="@color/filter_status_bg"
                app:strokeColor="?attr/colorPrimary"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvStatusPending"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/proza_libre_regular"
                    android:includeFontPadding="false"
                    android:text="@string/filterStatusPending"
                    android:textSize="@dimen/text_size_12" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Glass card — fills remaining space -->
        <FrameLayout
            android:id="@+id/flCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/page_margin_horizontal"
            android:layout_marginEnd="@dimen/page_margin_horizontal"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/page_margin_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llStatusTabs">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransactions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="@dimen/margin_small_medium"
                android:paddingVertical="@dimen/margin_large"
                android:scrollbars="none"
                tools:listitem="@layout/item_transaction" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/margin_small_medium"
                android:paddingVertical="@dimen/margin_large"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/lyt_shimmer_transaction_item" />
                    <include layout="@layout/lyt_shimmer_transaction_item" />
                    <include layout="@layout/lyt_shimmer_transaction_item" />
                    <include layout="@layout/lyt_shimmer_transaction_item" />
                    <include layout="@layout/lyt_shimmer_transaction_item" />
                    <include layout="@layout/lyt_shimmer_transaction_item" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/proza_libre_medium"
                android:includeFontPadding="false"
                android:text="@string/msgNoTransactionsFound"
                android:textColor="?attr/colorTextSubtitle"
                android:textSize="@dimen/text_size_14"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbLoadMore"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/margin_medium"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
