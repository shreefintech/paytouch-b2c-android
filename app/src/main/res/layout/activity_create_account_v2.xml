<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="onClickListener"
            type="android.view.View.OnClickListener" />
        <variable
            name="showProgress"
            type="androidx.databinding.ObservableBoolean" />
        <import type="android.view.View" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/img_screen_bg"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Wallet illustration -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivWalletIllustration"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:scaleType="fitEnd"
                android:src="@drawable/img_wallet_recolored"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- PayTouch logo -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivLogo"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginStart="@dimen/page_margin_horizontal"
                android:layout_marginTop="@dimen/margin_medium"
                android:scaleType="fitStart"
                android:src="@drawable/img_paytouch"
                app:layout_constraintEnd_toStartOf="@id/ivWalletIllustration"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.55" />

            <!-- Welcome! -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_margin_horizontal"
                android:layout_marginTop="@dimen/margin_extra_large"
                android:ellipsize="end"
                android:fontFamily="@font/proza_libre_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/welcomeCreateAccount"
                android:textColor="?attr/colorTextOnBrand"
                android:textSize="@dimen/text_size_22"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivLogo" />

            <!-- Subtitle -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/page_margin_horizontal"
                android:layout_marginTop="@dimen/margin_extra_small"
                android:layout_marginEnd="@dimen/margin_extra_small"
                android:ellipsize="end"
                android:fontFamily="@font/proza_libre_medium"
                android:includeFontPadding="false"
                android:maxLines="3"
                android:text="@string/createAccountSubtitle"
                android:textColor="?attr/colorTextOnBrand"
                android:textSize="@dimen/text_size_14"
                app:layout_constraintEnd_toStartOf="@id/ivWalletIllustration"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvWelcome" />

            <!-- Glass card -->
            <FrameLayout
                android:id="@+id/flCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xxlarge"
                android:layout_marginHorizontal="@dimen/page_margin_horizontal"
                android:layout_marginBottom="@dimen/margin_medium"
                android:clipToOutline="true"
                android:outlineProvider="background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
                tools:targetApi="31">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/page_margin_horizontal"
                    tools:ignore="UselessParent">

                    <!-- Full Name label -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_semi_bold"
                        android:includeFontPadding="false"
                        android:text="@string/labelFullName"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Name input -->
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/margin_small"
                        android:background="@drawable/bg_input_field"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_medium"
                        android:hint="@string/hintName"
                        android:includeFontPadding="false"
                        android:inputType="textNoSuggestions"
                        android:maxLength="150"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/margin_small"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="?attr/colorTextHint"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Mobile Number label -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_semi_bold"
                        android:includeFontPadding="false"
                        android:text="@string/label_mobile_number"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Mobile input -->
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etMobile"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/margin_small"
                        android:background="@drawable/bg_input_field"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_medium"
                        android:hint="@string/hint_mobile"
                        android:includeFontPadding="false"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/margin_small"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="?attr/colorTextHint"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Email Address label -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_semi_bold"
                        android:includeFontPadding="false"
                        android:text="@string/labelEmailAddress"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Email input -->
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/margin_small"
                        android:background="@drawable/bg_input_field"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_medium"
                        android:hint="@string/hintEmail"
                        android:includeFontPadding="false"
                        android:inputType="textEmailAddress|textNoSuggestions"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/margin_small"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="?attr/colorTextHint"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Aadhaar Number label -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_semi_bold"
                        android:includeFontPadding="false"
                        android:text="@string/labelAadharCardNumber"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Aadhaar Number input with eye toggle -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/margin_small"
                        android:background="@drawable/bg_input_field">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etAadhaarNumber"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:ellipsize="end"
                            android:fontFamily="@font/proza_libre_medium"
                            android:hint="@string/hintAadharCardNumber"
                            android:includeFontPadding="false"
                            android:inputType="number|textNoSuggestions"
                            android:maxLength="12"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/margin_small"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textColorHint="?attr/colorTextHint"
                            android:textSize="@dimen/text_size_13" />
                    </FrameLayout>

                    <!-- Aadhaar Photo label -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_semi_bold"
                        android:includeFontPadding="false"
                        android:text="@string/labelAadhaarPhoto"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Aadhaar Photo upload zone (KYC-style) -->
                    <FrameLayout
                        android:id="@+id/flAadhaarUpload"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/kyc_upload_height"
                        android:layout_marginTop="@dimen/margin_small"
                        android:background="@drawable/bg_upload_area"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Upload prompt (visible before file) -->
                        <LinearLayout
                            android:id="@+id/llUploadPrompt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical">

                            <com.shreefintech.paytouchconsumer.widget.LiquidGlassButton
                                android:id="@+id/flUploadAadhaarBtn"
                                android:layout_width="@dimen/btn_height"
                                android:layout_height="@dimen/btn_height"
                                android:onClickListener="@{onClickListener}"
                                app:glassCornerRadius="@dimen/submit_btn_radius"
                                app:normalTint="@android:color/transparent"
                                app:pressedTint="@color/upload_btn_color">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/margin_small"
                                    android:src="@drawable/ic_upload"
                                    android:tint="@color/primary" />

                            </com.shreefintech.paytouchconsumer.widget.LiquidGlassButton>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_extra_small"
                                android:fontFamily="@font/proza_libre_medium"
                                android:includeFontPadding="false"
                                android:text="@string/labelAadhaarPhoto"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_size_12" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_tiny"
                                android:fontFamily="@font/proza_libre_medium"
                                android:includeFontPadding="false"
                                android:text="@string/msgUploadHint"
                                android:textColor="@color/hint_color"
                                android:textSize="@dimen/text_size_10" />

                        </LinearLayout>

                        <!-- Preview card (GONE until file selected) -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="2dp"
                            android:background="@android:color/transparent"
                            app:cardBackgroundColor="@color/upload_doc_card_bg"
                            app:cardCornerRadius="@dimen/card_corner_radius"
                            app:cardElevation="0dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivPreviewAadhaar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                        </androidx.cardview.widget.CardView>

                        <!-- Edit / Delete row (GONE until file selected) -->
                        <LinearLayout
                            android:id="@+id/llEditDeleteAadhaar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="@dimen/margin_extra_small"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <FrameLayout
                                android:id="@+id/flEditAadhaar"
                                android:layout_width="@dimen/upload_edit_size"
                                android:layout_height="@dimen/upload_edit_size"
                                android:onClickListener="@{onClickListener}"
                                android:layout_marginTop="@dimen/margin_tiny"
                                android:layout_marginHorizontal="@dimen/margin_medium">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/ivEditAadhaar"
                                    android:layout_width="@dimen/upload_edit_size"
                                    android:layout_height="@dimen/upload_edit_size"
                                    android:background="?selectableItemBackgroundBorderless"
                                    android:padding="2dp"
                                    android:src="@drawable/ic_edit_placeholder"
                                    android:tint="@color/form_wizard_success" />

                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/flDeleteAadhaar"
                                android:layout_width="@dimen/upload_edit_size"
                                android:layout_height="@dimen/upload_edit_size"
                                android:layout_marginTop="@dimen/margin_small"
                                android:layout_marginHorizontal="@dimen/margin_medium">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/ivDeleteAadhaar"
                                    android:layout_width="@dimen/upload_edit_size"
                                    android:layout_height="@dimen/upload_edit_size"
                                    android:onClickListener="@{onClickListener}"
                                    android:background="?selectableItemBackgroundBorderless"
                                    android:padding="2dp"
                                    android:src="@drawable/ic_cross"
                                    android:tint="@color/form_wizard_reject" />

                            </FrameLayout>

                        </LinearLayout>
                    </FrameLayout>

                    <!-- State + City side by side -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:orientation="horizontal">

                        <!-- State column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/proza_libre_semi_bold"
                                android:includeFontPadding="false"
                                android:text="@string/labelState"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_size_13" />

                            <FrameLayout
                                android:id="@+id/flStateAnchor"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/input_height"
                                android:layout_marginTop="@dimen/margin_small"
                                android:background="@drawable/bg_input_field"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClickListener="@{onClickListener}">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvState"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/proza_libre_medium"
                                    android:gravity="center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:paddingHorizontal="@dimen/margin_small"
                                    android:paddingEnd="24dp"
                                    android:text="@string/hintSelectState"
                                    android:textColor="?attr/colorTextHint"
                                    android:textSize="@dimen/text_size_13" />

                                <FrameLayout
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center_vertical|end"
                                    android:layout_marginEnd="@dimen/margin_small">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivStateArrow"
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_down_arrow"
                                        android:tint="@color/primary" />

                                    <ProgressBar
                                        android:id="@+id/pbStateLoading"
                                        style="?android:attr/progressBarStyleSmall"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:indeterminateTint="@color/primary"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </FrameLayout>
                        </LinearLayout>

                        <!-- City column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/proza_libre_semi_bold"
                                android:includeFontPadding="false"
                                android:text="@string/labelCity"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_size_13" />

                            <FrameLayout
                                android:id="@+id/flCityAnchor"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/input_height"
                                android:layout_marginTop="@dimen/margin_small"
                                android:background="@drawable/bg_input_field"
                                android:clickable="true"
                                android:focusable="true"
                                android:onClickListener="@{onClickListener}">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:id="@+id/tvCity"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/proza_libre_medium"
                                    android:gravity="center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:paddingHorizontal="@dimen/margin_small"
                                    android:paddingEnd="24dp"
                                    android:text="@string/hintSelectCity"
                                    android:textColor="?attr/colorTextHint"
                                    android:textSize="@dimen/text_size_13" />

                                <FrameLayout
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center_vertical|end"
                                    android:layout_marginEnd="@dimen/margin_small">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivCityArrow"
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_down_arrow"
                                        android:tint="@color/primary" />

                                    <ProgressBar
                                        android:id="@+id/pbCityLoading"
                                        style="?android:attr/progressBarStyleSmall"
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:indeterminateTint="@color/primary"
                                        android:visibility="gone" />
                                </FrameLayout>
                            </FrameLayout>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Referral Code label row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/proza_libre_semi_bold"
                            android:includeFontPadding="false"
                            android:text="@string/labelReferralCode"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_size_13" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_tiny"
                            android:fontFamily="@font/proza_libre_medium"
                            android:includeFontPadding="false"
                            android:text="@string/labelOptional"
                            android:textColor="?attr/colorTextHint"
                            android:textSize="@dimen/text_size_11" />
                    </LinearLayout>

                    <!-- Referral Code input -->
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etReferralCode"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/margin_small"
                        android:background="@drawable/bg_input_field"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_medium"
                        android:hint="@string/hintReferralCode"
                        android:includeFontPadding="false"
                        android:inputType="textNoSuggestions"
                        android:maxLines="1"
                        android:paddingHorizontal="@dimen/margin_small"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="?attr/colorTextHint"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Password label -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_semi_bold"
                        android:includeFontPadding="false"
                        android:text="@string/label_password"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Password input with eye toggle -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/margin_small"
                        android:background="@drawable/bg_input_field">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:ellipsize="end"
                            android:fontFamily="@font/proza_libre_medium"
                            android:hint="@string/hint_password"
                            android:includeFontPadding="false"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/margin_small"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textColorHint="?attr/colorTextHint"
                            android:textSize="@dimen/text_size_13" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPasswordToggle"
                            android:layout_width="@dimen/icon_small"
                            android:layout_height="@dimen/icon_small"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="@dimen/margin_large"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClickListener="@{onClickListener}"
                            android:src="@drawable/ic_eye_off"
                            android:tint="@color/black" />
                    </FrameLayout>

                    <!-- Confirm Password label -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:ellipsize="end"
                        android:fontFamily="@font/proza_libre_semi_bold"
                        android:includeFontPadding="false"
                        android:text="@string/labelConfirmPassword"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_13" />

                    <!-- Confirm Password input with eye toggle -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/margin_small"
                        android:background="@drawable/bg_input_field">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:ellipsize="end"
                            android:fontFamily="@font/proza_libre_medium"
                            android:hint="@string/hintConfirmPassword"
                            android:includeFontPadding="false"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:paddingHorizontal="@dimen/margin_small"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textColorHint="?attr/colorTextHint"
                            android:textSize="@dimen/text_size_13" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivConfirmPasswordToggle"
                            android:layout_width="@dimen/icon_small"
                            android:layout_height="@dimen/icon_small"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="@dimen/margin_large"
                            android:clickable="true"
                            android:focusable="true"
                            android:onClickListener="@{onClickListener}"
                            android:src="@drawable/ic_eye_off"
                            android:tint="@color/black" />
                    </FrameLayout>

                    <!-- Terms & Conditions row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginStart="@dimen/checkbox_row_negative_margin"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatCheckBox
                            android:id="@+id/cbTerms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="?attr/colorPrimary"
                            android:minHeight="0dp"
                            android:minWidth="0dp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvTerms"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:layout_weight="1"
                            android:fontFamily="@font/proza_libre_medium"
                            android:includeFontPadding="false"
                            android:text="@string/labelTermsConditions"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_12" />
                    </LinearLayout>

                    <!-- Create Account button -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/margin_extra_large"
                        android:layout_marginBottom="@dimen/margin_small"
                        app:cardBackgroundColor="?attr/colorPrimary"
                        app:cardCornerRadius="@dimen/button_corner_radius"
                        app:cardElevation="@dimen/card_elevation">

                        <LinearLayout
                            android:id="@+id/llCreateAccount"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?selectableItemBackground"
                            android:gravity="center"
                            android:onClickListener="@{onClickListener}"
                            android:orientation="horizontal"
                            android:visibility="@{showProgress ? View.INVISIBLE : View.VISIBLE}">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/icon_medium"
                                android:layout_height="@dimen/icon_medium"
                                android:layout_marginEnd="@dimen/margin_small_medium"
                                android:src="@drawable/ic_create_account" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/create_account"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_size_16"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginVertical="@dimen/margin_small"
                            android:indeterminateTint="@color/white"
                            android:visibility="@{showProgress ? View.VISIBLE : View.GONE}"
                            tools:visibility="gone" />
                    </androidx.cardview.widget.CardView>

                    <!-- Back to Sign In -->
                    <LinearLayout
                        android:id="@+id/tvBackToSignIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginBottom="@dimen/margin_small"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?selectableItemBackground"
                        android:gravity="center_vertical"
                        android:onClickListener="@{onClickListener}"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/icon_small"
                            android:layout_height="@dimen/icon_small"
                            android:src="@drawable/ic_signin"
                            android:tint="@color/black" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:ellipsize="end"
                            android:fontFamily="@font/proza_libre_medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/backToSignIn"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_13" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
