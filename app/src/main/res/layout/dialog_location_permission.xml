<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by the awareness, rationale and open-settings states — text is set in LocationPermissionHelper -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="onClickListener"
            type="android.view.View.OnClickListener" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dialog_corner_radius"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dialog_padding_horizontal"
            android:paddingTop="@dimen/dialog_padding_top"
            android:paddingBottom="@dimen/dialog_padding_horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_location"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/proza_libre_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/titleLocationAccess"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivIcon" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small_medium"
                android:fontFamily="@font/proza_libre_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:text="@string/msgLocationAwareness"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <!-- Visible only in the first-time awareness state -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPoints"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_medium"
                android:fontFamily="@font/proza_libre_medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="6dp"
                android:text="@string/labelLocationPoints"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_size_13"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMessage" />

            <LinearLayout
                android:id="@+id/llButtons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_extra_large"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPoints">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnPositive"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginEnd="@dimen/margin_small"
                    android:layout_weight="1"
                    android:onClickListener="@{onClickListener}"
                    app:cardBackgroundColor="@color/primary"
                    app:cardCornerRadius="@dimen/dialog_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvPositive"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?selectableItemBackground"
                        android:fontFamily="@font/proza_libre_semi_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/btnAllow"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_size_14" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnNegative"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginStart="@dimen/margin_small"
                    android:layout_weight="1"
                    android:onClickListener="@{onClickListener}"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/dialog_corner_radius"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1.5dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?selectableItemBackground"
                        android:fontFamily="@font/proza_libre_semi_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/btnNotNow"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_14" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</layout>
