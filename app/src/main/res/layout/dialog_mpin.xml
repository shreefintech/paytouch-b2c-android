<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="onClickListener"
            type="android.view.View.OnClickListener" />
        <variable
            name="showProgress"
            type="androidx.databinding.ObservableBoolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dialog_padding_horizontal"
        android:background="@drawable/bg_transaction_item"
        android:paddingTop="@dimen/margin_extra_large"
        android:paddingBottom="@dimen/dialog_padding_horizontal">

        <!-- Title -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/proza_libre_semi_bold"
            android:text="@string/titleEnterMpin"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_18"
            app:layout_constraintEnd_toStartOf="@id/cardClose"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Close button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:onClickListener="@{onClickListener}"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/margin_extra_small"
                android:src="@drawable/ic_cross"
                app:tint="@color/primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Subtitle -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small_medium"
            android:fontFamily="@font/proza_libre_medium"
            android:text="@string/msgEnterMpinBankSubtitle"
            android:textColor="@color/sub_text_color"
            android:textSize="@dimen/text_size_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- MPIN label -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvMpinLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_extra_large"
            android:fontFamily="@font/proza_libre_semi_bold"
            android:text="@string/label_mpin"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_13"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <!-- MPIN input -->
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etMpin"
            android:layout_width="0dp"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="@dimen/margin_small"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/proza_libre_medium"
            android:hint="@string/hint_mpin"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/margin_small"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="?attr/colorTextHint"
            android:textSize="@dimen/text_size_13"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMpinLabel" />

        <!-- Submit button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSubmit"
            android:layout_width="0dp"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/margin_extra_large"
            android:onClickListener="@{onClickListener}"
            app:cardBackgroundColor="@color/primary"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etMpin"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/proza_libre_medium"
                    android:text="@string/btnSubmit"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_16"
                    android:visibility="@{showProgress ? View.GONE : View.VISIBLE}" />

                <ProgressBar
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminateTint="@color/white"
                    android:visibility="@{showProgress ? View.VISIBLE : View.GONE}" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
