<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Account Number -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_medium"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/kyc_icon_bg_size"
            android:layout_height="@dimen/kyc_icon_bg_size"
            android:layout_marginEnd="@dimen/margin_medium"
            app:cardBackgroundColor="@color/kyc_icon_bg"
            app:cardCornerRadius="5dp"
            app:cardElevation="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/margin_small"
                android:src="@drawable/ic_user_1"
                android:tint="@color/primary" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/proza_libre_medium"
                android:includeFontPadding="false"
                android:text="@string/labelBankAccountNumber"
                android:textColor="@color/personal_info_label"
                android:textSize="@dimen/text_size_11" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvAccountNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/proza_libre_semi_bold"
                android:includeFontPadding="false"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_13" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ivEditBank"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/margin_small"
            android:visibility="gone"
            app:cardBackgroundColor="@color/primary_light"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:src="@drawable/ic_toast_edit"
                android:tint="@color/primary" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Bank Name (with icon) | IFSC code (no icon) — two columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_medium"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/kyc_icon_bg_size"
                android:layout_height="@dimen/kyc_icon_bg_size"
                android:layout_marginEnd="@dimen/margin_medium"
                app:cardBackgroundColor="@color/kyc_icon_bg"
                app:cardCornerRadius="5dp"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/margin_small"
                    android:src="@drawable/ic_bank"
                    android:tint="@color/primary" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/proza_libre_medium"
                    android:includeFontPadding="false"
                    android:text="@string/labelBankName"
                    android:textColor="@color/personal_info_label"
                    android:textSize="@dimen/text_size_11" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvBankName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/proza_libre_semi_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_13" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:background="@color/sheet_divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/proza_libre_medium"
                android:includeFontPadding="false"
                android:text="@string/labelIfscCode"
                android:textColor="@color/personal_info_label"
                android:textSize="@dimen/text_size_11" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvIfsc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/proza_libre_semi_bold"
                android:includeFontPadding="false"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_13" />
        </LinearLayout>
    </LinearLayout>

    <!-- Branch name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small_medium"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/kyc_icon_bg_size"
            android:layout_height="@dimen/kyc_icon_bg_size"
            android:layout_marginEnd="@dimen/margin_medium"
            app:cardBackgroundColor="@color/kyc_icon_bg"
            app:cardCornerRadius="5dp"
            app:cardElevation="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/margin_small"
                android:src="@drawable/ic_location"
                android:tint="@color/primary" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/proza_libre_medium"
                android:includeFontPadding="false"
                android:text="@string/labelBranchName"
                android:textColor="@color/personal_info_label"
                android:textSize="@dimen/text_size_11" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvBranchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/proza_libre_semi_bold"
                android:includeFontPadding="false"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_13" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider between accounts -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/margin_medium"
        android:background="@color/sheet_divider" />

</LinearLayout>
