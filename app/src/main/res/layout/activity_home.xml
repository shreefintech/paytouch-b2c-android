<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="onClickListener"
            type="android.view.View.OnClickListener" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/img_screen_bg"
        tools:context=".HomeActivity">

        <!-- Toolbar -->
        <include
            android:id="@+id/lytToolbar"
            layout="@layout/lyt_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lytToolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/incBannerSlider"
                    layout="@layout/lyt_banner_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:layout_marginHorizontal="@dimen/page_margin_horizontal"
                    android:layout_marginBottom="@dimen/margin_small" />

            <!-- White categories card -->
            <FrameLayout
                android:id="@+id/flCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToOutline="true"
                android:outlineProvider="background"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/dialog_corner_radius"
                app:cardElevation="4dp"
                android:layout_marginStart="@dimen/page_margin_horizontal"
                android:layout_marginTop="@dimen/margin_medium"
                android:layout_marginEnd="@dimen/page_margin_horizontal"
                android:layout_marginBottom="@dimen/margin_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/margin_medium">

                    <!-- category grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/margin_medium"
                        android:paddingBottom="@dimen/margin_medium">

                        <!-- Section title -->
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_large"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:fontFamily="@font/proza_libre_bold"
                            android:includeFontPadding="false"
                            android:text="@string/titleCategories"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_size_18" />

                        <!-- Row 1: Electricity | Gas | Prepaid -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_large"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/margin_small"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/white"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:id="@+id/llElectricity"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?selectableItemBackground"
                                    android:gravity="center"
                                    android:onClickListener="@{onClickListener}"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/margin_extra_small"
                                    android:paddingTop="@dimen/margin_medium"
                                    android:paddingEnd="@dimen/margin_extra_small"
                                    android:paddingBottom="@dimen/margin_medium">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivElectricity"
                                        android:layout_width="@dimen/category_icon_size"
                                        android:layout_height="@dimen/category_icon_size"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_electricity" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:fontFamily="@font/proza_libre_semi_bold"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="@string/categoryElectricity"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>


                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small"
                                android:layout_marginEnd="@dimen/margin_small"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/white"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:id="@+id/llGas"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?selectableItemBackground"
                                    android:gravity="center"
                                    android:onClickListener="@{onClickListener}"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/margin_extra_small"
                                    android:paddingTop="@dimen/margin_medium"
                                    android:paddingEnd="@dimen/margin_extra_small"
                                    android:paddingBottom="@dimen/margin_medium">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivGas"
                                        android:layout_width="@dimen/category_icon_size"
                                        android:layout_height="@dimen/category_icon_size"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_gas" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:fontFamily="@font/proza_libre_semi_bold"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="@string/categoryGas"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>


                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/white"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1dp">


                                <LinearLayout
                                    android:id="@+id/llPrepaid"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?selectableItemBackground"
                                    android:gravity="center"
                                    android:onClickListener="@{onClickListener}"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/margin_extra_small"
                                    android:paddingTop="@dimen/margin_medium"
                                    android:paddingEnd="@dimen/margin_extra_small"
                                    android:paddingBottom="@dimen/margin_medium">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivPrepaid"
                                        android:layout_width="@dimen/category_icon_size"
                                        android:layout_height="@dimen/category_icon_size"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_prepaid" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:fontFamily="@font/proza_libre_semi_bold"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="@string/categoryPrepaid"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>


                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Row 2: TV Cable | DTH | Fastag -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_extra_large"
                            android:orientation="horizontal">


                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/margin_small"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/white"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:id="@+id/llPostpaid"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?selectableItemBackground"
                                    android:gravity="center"
                                    android:onClickListener="@{onClickListener}"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/margin_extra_small"
                                    android:paddingTop="@dimen/margin_medium"
                                    android:paddingEnd="@dimen/margin_extra_small"
                                    android:paddingBottom="@dimen/margin_medium">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivPostpaid"
                                        android:layout_width="@dimen/category_icon_size"
                                        android:layout_height="@dimen/category_icon_size"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_postpaid" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:fontFamily="@font/proza_libre_semi_bold"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="@string/categoryPostpaid"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small"
                                android:layout_marginEnd="@dimen/margin_small"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/white"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:id="@+id/llDth"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?selectableItemBackground"
                                    android:gravity="center"
                                    android:onClickListener="@{onClickListener}"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/margin_extra_small"
                                    android:paddingTop="@dimen/margin_medium"
                                    android:paddingEnd="@dimen/margin_extra_small"
                                    android:paddingBottom="@dimen/margin_medium">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivDth"
                                        android:layout_width="@dimen/category_icon_size"
                                        android:layout_height="@dimen/category_icon_size"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_broadband" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:fontFamily="@font/proza_libre_semi_bold"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="@string/categoryDth"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/white"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:id="@+id/llFastag"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?selectableItemBackground"
                                    android:gravity="center"
                                    android:onClickListener="@{onClickListener}"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/margin_extra_small"
                                    android:paddingTop="@dimen/margin_medium"
                                    android:paddingEnd="@dimen/margin_extra_small"
                                    android:paddingBottom="@dimen/margin_medium">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivFastag"
                                        android:layout_width="@dimen/category_icon_size"
                                        android:layout_height="@dimen/category_icon_size"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_fastag" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:fontFamily="@font/proza_libre_semi_bold"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="@string/categoryFastag"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>


                        </LinearLayout>

                        <!-- Row 3: Loan | My Account | Tax -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_extra_large"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/margin_small"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/white"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:id="@+id/llLoan"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?selectableItemBackground"
                                    android:gravity="center"
                                    android:onClickListener="@{onClickListener}"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/margin_extra_small"
                                    android:paddingTop="@dimen/margin_medium"
                                    android:paddingEnd="@dimen/margin_extra_small"
                                    android:paddingBottom="@dimen/margin_medium">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivLoan"
                                        android:layout_width="@dimen/category_icon_size"
                                        android:layout_height="@dimen/category_icon_size"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_loan" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:fontFamily="@font/proza_libre_semi_bold"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="@string/categoryLoan"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small"
                                android:layout_marginEnd="@dimen/margin_small"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/white"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:id="@+id/llTax"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?selectableItemBackground"
                                    android:gravity="center"
                                    android:onClickListener="@{onClickListener}"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/margin_extra_small"
                                    android:paddingTop="@dimen/margin_medium"
                                    android:paddingEnd="@dimen/margin_extra_small"
                                    android:paddingBottom="@dimen/margin_medium">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivTax"
                                        android:layout_width="@dimen/category_icon_size"
                                        android:layout_height="@dimen/category_icon_size"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_tax" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:fontFamily="@font/proza_libre_semi_bold"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="@string/categoryMunicipalTax"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/white"
                                app:cardElevation="0dp"
                                app:strokeColor="?attr/colorPrimary"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:id="@+id/llMyAccount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?selectableItemBackground"
                                    android:gravity="center"
                                    android:onClickListener="@{onClickListener}"
                                    android:orientation="vertical"
                                    android:paddingStart="@dimen/margin_extra_small"
                                    android:paddingTop="@dimen/margin_medium"
                                    android:paddingEnd="@dimen/margin_extra_small"
                                    android:paddingBottom="@dimen/margin_medium">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:id="@+id/ivMyAccount"
                                        android:layout_width="@dimen/category_icon_size"
                                        android:layout_height="@dimen/category_icon_size"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_profile" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/margin_small"
                                        android:fontFamily="@font/proza_libre_semi_bold"
                                        android:gravity="center"
                                        android:includeFontPadding="false"
                                        android:text="@string/categoryMyAccount"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/text_size_11" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Load Wallet — scrolls with content, last item in NestedScrollView -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvLoadWallet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_large"
                        android:layout_marginTop="@dimen/margin_small_medium"
                        android:layout_marginEnd="@dimen/margin_large"
                        android:layout_marginBottom="@dimen/margin_large"
                        android:onClickListener="@{onClickListener}"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/img_wallet_banner_bg"
                            android:minHeight="100dp"
                            android:paddingStart="@dimen/margin_large"
                            android:paddingTop="@dimen/margin_medium"
                            android:paddingEnd="@dimen/margin_medium"
                            android:paddingBottom="@dimen/margin_medium">

                            <!-- Left: title + subtitle + button -->
                            <LinearLayout
                                android:id="@+id/llLoadWalletContent"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/ivLoadWallet"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/proza_libre_bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/btnLoadWallet"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_18" />

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/proza_libre_regular"
                                    android:includeFontPadding="false"
                                    android:text="@string/msgLoadWalletSubtitle"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_size_11" />

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/margin_small_medium"
                                    app:cardBackgroundColor="@color/white"
                                    app:cardCornerRadius="20dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingStart="@dimen/margin_small_medium"
                                        android:paddingTop="6dp"
                                        android:paddingEnd="@dimen/margin_small_medium"
                                        android:paddingBottom="6dp">

                                        <androidx.appcompat.widget.AppCompatTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/proza_libre_semi_bold"
                                            android:includeFontPadding="false"
                                            android:text="@string/titleAddMoney"
                                            android:textColor="?attr/colorPrimary"
                                            android:textSize="@dimen/text_size_12" />

                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="14dp"
                                            android:layout_height="14dp"
                                            android:layout_marginStart="4dp"
                                            android:src="@drawable/ic_arrow_up"
                                            android:tint="?attr/colorPrimary" />

                                    </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                            </LinearLayout>

                            <!-- Right: animated wallet image -->
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivLoadWallet"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:src="@drawable/ic_wallet"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </FrameLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
