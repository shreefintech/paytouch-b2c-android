<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/page_margin_horizontal">

        <!-- Guide text -->
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/proza_libre_medium"
            android:includeFontPadding="false"
            android:textAlignment="center"
            android:text="@string/msgSelfieGuide"
            android:textColor="@color/black"
            android:textSize="@dimen/text_size_13" />

        <!-- Selfie area -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:strokeWidth="1dp"
            app:strokeColor="@color/selfie_card_stroke"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="@dimen/margin_medium"
            android:padding="@dimen/margin_medium">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingVertical="@dimen/margin_extra_large"
                android:paddingHorizontal="@dimen/margin_large">


                <FrameLayout
                    android:id="@+id/flSelfie"
                    android:layout_width="@dimen/kyc_selfie_size"
                    android:layout_height="@dimen/kyc_selfie_size"
                    android:background="@drawable/bg_selfie_guide"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Guide circle (visible before capture) -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivSelfieGuide"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="40dp"
                        android:src="@drawable/ic_selfie" />

                    <!-- Selfie preview circle (GONE until captured) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcvSelfiePreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="visible"
                        app:strokeWidth="0dp"
                        android:layout_margin="2dp"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardElevation="0dp"
                        app:shapeAppearance="@style/CircleCard">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivSelfiePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />

                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <!-- Instructions -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDes1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_large"
                    android:fontFamily="@font/proza_libre_medium"
                    android:includeFontPadding="false"
                    android:text="@string/msgSelfieInstruction1"
                    android:textColor="@color/hint_color"
                    android:textSize="@dimen/text_size_12"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/flSelfie"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvDes2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_extra_small"
                    android:fontFamily="@font/proza_libre_medium"
                    android:includeFontPadding="false"
                    android:text="@string/msgSelfieInstruction2"
                    android:textColor="@color/hint_color"
                    app:layout_constraintTop_toBottomOf="@id/tvDes1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textSize="@dimen/text_size_12" />


                <LinearLayout
                    android:id="@+id/llSelfieActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <FrameLayout
                        android:id="@+id/flEdit1"
                        android:layout_width="@dimen/upload_edit_size"
                        android:layout_height="@dimen/upload_edit_size">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivEditProof1"
                            android:layout_width="@dimen/upload_edit_size"
                            android:layout_height="@dimen/upload_edit_size"
                            android:background="?selectableItemBackgroundBorderless"
                            android:padding="2dp"
                            android:src="@drawable/ic_edit_placeholder"
                            android:tint="@color/form_wizard_success" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/flDelete1"
                        android:layout_width="@dimen/upload_edit_size"
                        android:layout_height="@dimen/upload_edit_size"
                        android:layout_marginTop="@dimen/margin_small">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivDeleteProof1"
                            android:layout_width="@dimen/upload_edit_size"
                            android:layout_height="@dimen/upload_edit_size"
                            android:background="?selectableItemBackgroundBorderless"
                            android:padding="2dp"
                            android:src="@drawable/ic_cross"
                            android:tint="@color/form_wizard_reject" />

                    </FrameLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Capture button -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/margin_extra_large"
            app:cardBackgroundColor="@color/primary"
            app:cardCornerRadius="@dimen/button_corner_radius"
            app:strokeWidth="0dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/btnCapture"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/proza_libre_semi_bold"
                    android:includeFontPadding="false"
                    android:text="@string/btnCapture"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_size_14" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
