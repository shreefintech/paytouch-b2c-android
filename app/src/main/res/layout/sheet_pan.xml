<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="onClickListener"
            type="android.view.View.OnClickListener" />
        <variable
            name="showProgressPan"
            type="androidx.databinding.ObservableBoolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_bg"
        android:clickable="true"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:behavior_skipCollapsed="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvPan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="28dp">

                <!-- Title row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/proza_libre_bold"
                        android:includeFontPadding="false"
                        android:text="@string/titleAddPanCard"
                        android:textColor="@color/primary"
                        android:textSize="20sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/ivClosePan"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:onClickListener="@{onClickListener}"
                        app:cardBackgroundColor="@color/earningCloseBg"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_close"
                            android:tint="@color/primary" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Subtitle -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/proza_libre_regular"
                    android:includeFontPadding="false"
                    android:text="@string/msgPanCardSubtitle"
                    android:textColor="@color/sub_text_color"
                    android:textSize="13sp" />

                <!-- PAN label -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/proza_libre_semi_bold"
                    android:includeFontPadding="false"
                    android:text="@string/labelPanCardNumber"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_size_13" />

                <!-- PAN input -->
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etPanNumber"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/margin_small"
                    android:background="@drawable/bg_input_field"
                    android:fontFamily="@font/proza_libre_medium"
                    android:hint="@string/hintPanCardNumber"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="10"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/margin_small"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="?attr/colorTextHint"
                    android:textSize="@dimen/text_size_13" />

                <!-- Submit button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnSubmitPan"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:layout_marginTop="20dp"
                    android:onClickListener="@{onClickListener}"
                    app:cardBackgroundColor="@color/primary"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/proza_libre_semi_bold"
                            android:includeFontPadding="false"
                            android:text="@string/btnSubmit"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:visibility="@{showProgressPan ? View.GONE : View.VISIBLE}" />

                        <ProgressBar
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:indeterminateTint="@color/white"
                            android:visibility="@{showProgressPan ? View.VISIBLE : View.GONE}" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Skip link -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvSkipPan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/proza_libre_medium"
                    android:onClickListener="@{onClickListener}"
                    android:text="@string/btnSkipPan"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
