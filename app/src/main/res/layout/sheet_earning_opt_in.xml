<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="onClickListener"
            type="android.view.View.OnClickListener" />
        <variable
            name="showProgressOptIn"
            type="androidx.databinding.ObservableBoolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_bg"
        android:clickable="true"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:behavior_skipCollapsed="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvOptIn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="28dp">

                <!-- Title row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/proza_libre_bold"
                        android:includeFontPadding="false"
                        android:text="@string/titleOptIn"
                        android:textColor="@color/earningInk"
                        android:textSize="20sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/ivCloseOptIn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:onClickListener="@{onClickListener}"
                        app:cardBackgroundColor="@color/earningCloseBg"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_close"
                            android:tint="@color/primary" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Subtitle -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/proza_libre_regular"
                    android:includeFontPadding="false"
                    android:text="@string/msgOptInSubtitle"
                    android:textColor="@color/earningMuted"
                    android:textSize="13sp" />

                <!-- Rule 1: 11% a year -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardBackgroundColor="@color/primary_light"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_piggy"
                            android:tint="@color/primary" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/proza_libre_bold"
                            android:includeFontPadding="false"
                            android:text="@string/msgOptInRule1Title"
                            android:textColor="@color/earningInk"
                            android:textSize="14sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/proza_libre_regular"
                            android:includeFontPadding="false"
                            android:text="@string/msgOptInRule1Desc"
                            android:textColor="@color/earningMuted"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Rule 2: Interest moves in chunks -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardBackgroundColor="@color/primary_light"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_trend_up"
                            android:tint="@color/primary" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/proza_libre_bold"
                            android:includeFontPadding="false"
                            android:text="@string/msgOptInRule2Title"
                            android:textColor="@color/earningInk"
                            android:textSize="14sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/proza_libre_regular"
                            android:includeFontPadding="false"
                            android:text="@string/msgOptInRule2Desc"
                            android:textColor="@color/earningMuted"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Rule 3: Withdraw in 3 days -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardBackgroundColor="@color/primary_light"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_clock"
                            android:tint="@color/primary" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/proza_libre_bold"
                            android:includeFontPadding="false"
                            android:text="@string/msgOptInRule3Title"
                            android:textColor="@color/earningInk"
                            android:textSize="14sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/proza_libre_regular"
                            android:includeFontPadding="false"
                            android:text="@string/msgOptInRule3Desc"
                            android:textColor="@color/earningMuted"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Rule 4: Withdrawing early -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        app:cardBackgroundColor="@color/primary_light"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_warning"
                            android:tint="@color/primary" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/proza_libre_bold"
                            android:includeFontPadding="false"
                            android:text="@string/msgOptInRule4Title"
                            android:textColor="@color/earningInk"
                            android:textSize="14sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/proza_libre_regular"
                            android:includeFontPadding="false"
                            android:text="@string/msgOptInRule4Desc"
                            android:textColor="@color/earningMuted"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Terms checkbox row -->
                <LinearLayout
                    android:id="@+id/llTerms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:onClickListener="@{onClickListener}"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbOptInTerms"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:button="@null"
                        android:background="@drawable/selector_checkbox_ew"
                        android:clickable="false"
                        android:focusable="false" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/proza_libre_regular"
                        android:includeFontPadding="false"
                        android:text="@string/msgOptInTerms"
                        android:textColor="@color/earningInk"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Opt-in button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnOptIn"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:layout_marginTop="14dp"
                    android:onClickListener="@{onClickListener}"
                    app:cardBackgroundColor="@color/earningDisabledBg"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="17dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvBtnOptInLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/proza_libre_semi_bold"
                            android:includeFontPadding="false"
                            android:text="@string/btnOptIn"
                            android:textColor="@color/earningDisabledText"
                            android:textSize="17sp"
                            android:visibility="@{showProgressOptIn ? View.GONE : View.VISIBLE}" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivBtnOptInIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_right_arrow"
                            android:tint="@color/earningDisabledText"
                            android:visibility="@{showProgressOptIn ? View.GONE : View.VISIBLE}" />

                        <ProgressBar
                            android:id="@+id/pbOptIn"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:indeterminateTint="@color/white"
                            android:visibility="@{showProgressOptIn ? View.VISIBLE : View.GONE}" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
