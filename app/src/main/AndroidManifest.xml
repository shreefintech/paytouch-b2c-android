<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground only — used for payment risk checks. Never request ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- KYC live selfie (SelfieCaptureActivity) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- CAMERA implies a required back camera; mark both optional so Play doesn't filter devices out -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".utill.MyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_app_logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_app_logo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PaytouchConsumer">
        <activity
            android:name=".auth.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.CreateAccountActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.CreateAccountV2Activity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.OtpVerificationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.ResetPasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.ResetMpinActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".applock.AppLockActivity"
            android:exported="false"
            android:theme="@style/Theme.PaytouchConsumer.AppLock" />
        <activity
            android:name="com.shreefintech.paytouchconsumer.kyc.KycActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.shreefintech.paytouchconsumer.kyc.KycStatusActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.shreefintech.paytouchconsumer.kyc.identity.IdentityVerificationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.shreefintech.paytouchconsumer.kyc.identity.SelfieCaptureActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.shreefintech.paytouchconsumer.kyc.bank.BankDetailsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".billpay.BillPayActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".operator.OperatorSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".billpay.transactions.RecentTransactionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".billpay.transactions.SmsReceiptActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".transactions.TransactionDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".transactions.TransactionHistoryDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".billpay.transactions.TransactionReportActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".billpay.transactions.TransactionStatusActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".billpay.BillPayPlanSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".myaccount.MyAccountActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".myaccount.KycDetailsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".myaccount.EditBankDetailsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".myaccount.DocPreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".myaccount.ContactUsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".loadwallet.LoadWalletActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".earningwallet.EarningWalletActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".rewards.RewardsExplainerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".loadwallet.WalletTransactionsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".loadwallet.HdfcWebViewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />
        <activity
            android:name=".loadwallet.PaymentStatusActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".transactions.BillPaymentStatusActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".rewards.MyRankActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".rewards.LevelUpActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name=".fcm.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Used by FCM when it posts notification-type pushes itself (app in background / killed) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/labelNotificationChannelId" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/img_paytouch" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
